# ---- LLM Provider ----
# Pick one: groq | openrouter | custom
LLM_PROVIDER=groq

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Custom provider — uncomment and fill to add any other API later
# (overrides the preset above; LLM_API_KEY/LLM_MODEL apply to all providers)
# LLM_BASE_URL=https://api.some-provider.com/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=your-model-name

# Model override (optional — otherwise the provider default is used)
# LLM_MODEL=llama-3.3-70b-versatile

# ---- n8n ----
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# Filled automatically by scripts/deploy.py after deploying workflows
N8N_RESEARCH_WEBHOOK=
N8N_SUMMARIZER_WEBHOOK=
N8N_EXTRACTOR_WEBHOOK=